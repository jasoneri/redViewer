{
  "$schema": "https://schema.tauri.app/v2/config.json",
  "productName": "rV",
  // RVBASE002: Tauri resolves this package.json path; do not replace with a concrete version.
  "version": "../package.json",
  "identifier": "jsoneri.redviewer",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:5140",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,	
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "jasoneri",
    "icon": [
      "../../assets/icons/icon.png",
      "../../assets/icons/icon.ico",
      "../../assets/icons/icon.icns"
    ],
    "externalBin": [
      "../../stage/uv"
    ],
    "resources": {
      "../../stage/src": "res/src",
      "../../stage/dist": "res/dist",
      "../../assets/configs/cn.toml": "res/conf/cn.toml",
      "../../assets/configs/global.toml": "res/conf/global.toml"
    },
    "windows": {
      "wix": {
        "fragmentPaths": ["./windows/firewall.wxs"],
        "componentRefs": ["RvMsiFirewallMarker"]
      },
      "nsis": {
        "template": "./windows/installer.nsi",
        "installerHooks": "./windows/hooks.nsh",
        // RVBASE004: firewall setup opens ports used by rV.exe and the Python backend child process.
        // Keep the installer elevation-capable; currentUser mode makes netsh firewall rules fail silently.
        "installMode": "both",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "sidebarImage": "../../assets/icons/setup.bmp",
        "installerIcon": "../../assets/icons/setup.ico"
      }
    },
    "macOS": {
      // Ad-hoc signing keeps Intel macOS CI builds working without Apple certs.
      "signingIdentity": "-"
    }
  },
  "plugins": {}
}
